---
import { site } from '../data/site.js';
const { title = 'See CrewTeams on one of your shifts.', text = 'We’ll walk a worker from verified clock-in to same-shift pay, using your sites and your rules.' } = Astro.props;
---
<section class="page-cta">
  <div class="wrap pc-inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn-light" href={site.demoUrl}>Request a Demo</a>
      <a class="btn btn-outline-light" href={`mailto:${site.email}`}>Email us</a>
    </div>
  </div>
</section>
<style>
  .page-cta { background: var(--brand-grad); color: #fff; padding: 72px 0; }
  .page-cta h2 { color: #fff; margin-bottom: .3em; }
  .page-cta p { margin: 0; opacity: .9; font-size: 1.1rem; max-width: 620px; }
  .pc-inner { display: flex; justify-content: space-between; align-items: center; gap: 32px; flex-wrap: wrap; }
</style>
