---
import Logo from './Logo.astro';

const links = [
  { href: '/#platform', label: 'Platform' },
  { href: '/#how-it-works', label: 'How it works' },
  { href: '/#industries', label: 'Industries' },
];
---

<a class="skip sr-only" href="#main">Skip to content</a>
<header class="header">
  <div class="container bar">
    <a href="/" aria-label="CrewTeams home"><Logo /></a>

    <nav aria-label="Primary">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <a class="btn btn-primary cta" href="/#demo">Book a demo</a>
  </div>
</header>

<style>
  .skip:focus {
    position: fixed; top: 8px; left: 8px; z-index: 100;
    width: auto; height: auto; clip: auto; padding: 10px 14px;
    background: #fff; border-radius: 8px;
  }
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 68px;
  }
  .bar > a:first-child { text-decoration: none; }
  ul { display: flex; gap: 32px; list-style: none; margin: 0; padding: 0; }
  nav a {
    color: var(--ink-soft);
    text-decoration: none;
    font-weight: 550;
    font-size: 0.95rem;
  }
  nav a:hover { color: var(--ink); }
  .cta { padding: 10px 18px; font-size: 0.95rem; }

  @media (max-width: 760px) {
    nav { display: none; }
    .cta { padding: 9px 14px; font-size: 0.9rem; }
  }
</style>
