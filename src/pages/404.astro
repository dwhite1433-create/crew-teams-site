---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.js';
---
<Base title="Coming soon | CrewTeams">
  <section class="section"><div class="wrap center">
    <span class="eyebrow">Coming soon</span>
    <h1>We’re still building this page.</h1>
    <p class="lede">The full CrewTeams site is on its way. In the meantime, we’re happy to walk you through the platform.</p>
    <div class="btn-row" style="justify-content:center">
      <a class="btn btn-primary" href={site.demoUrl}>Request a Demo</a>
      <a class="btn btn-ghost" href="/">Back to home</a>
    </div>
  </div></section>
</Base>
