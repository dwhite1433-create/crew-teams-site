---
import Base from '../../layouts/Base.astro';
import PageCTA from '../../components/PageCTA.astro';
import { site } from '../../data/site.js';

const pains = [
  { t: 'Re-keying timesheets', d: 'Someone types hours from one system into another every pay period, and mistakes ride along.' },
  { t: 'Worker lists that don’t match', d: 'New hires, terminations and rate changes land in HR but never reach the time clock.' },
  { t: 'One more silo', d: 'A new tool that doesn’t connect is just another place to check, and another place to be wrong.' },
];

// What moves, and which way. in = into CrewTeams, out = out of CrewTeams.
const systems = [
  {
    name: 'HR / HRIS',
    dir: 'In',
    lead: 'Your HR system stays the source of truth for who works for you.',
    flows: ['New hires, terminations and job changes', 'Worker details, roles and sites', 'Schedules, where your HR system holds them'],
  },
  {
    name: 'Payroll',
    dir: 'Out',
    lead: 'Payroll gets verified hours only. Nobody re-keys a timesheet.',
    flows: ['Verified hours by worker, site and job', 'Overtime and break premiums, already calculated under your rules', 'Exceptions flagged before the pay run'],
  },
  {
    name: 'ERP & business systems',
    dir: 'Both',
    lead: 'Labor data where finance and operations already look.',
    flows: ['Job, site and cost codes in', 'Labor hours and cost by job out', 'Anything else through our open APIs'],
  },
];

// A real sequence, so numbered.
const steps = [
  { t: 'Tell us what you run', d: 'Your HR, payroll and ERP systems, and what you need to move between them.' },
  { t: 'We map the data', d: 'Workers, sites, jobs and pay codes are matched between your systems and CrewTeams.' },
  { t: 'Test with your data', d: 'We run real workers and a real pay period through the connection before anything goes live.' },
  { t: 'Go live and monitor', d: 'Data flows on the schedule you choose, and we watch the first pay runs with you.' },
];

const faqs = [
  { q: 'Do you connect to the payroll or HR system we use?', a: 'Tell us what you run and we’ll confirm how we connect. CrewTeams uses open APIs, so most modern HR, payroll and ERP systems can be connected.' },
  { q: 'Do we have to replace our HR or payroll system?', a: 'No. CrewTeams works alongside the systems you already have. Your HR system stays the source of truth for workers, and payroll keeps running payroll.' },
  { q: 'Where do schedules come from?', a: 'From the system that already holds them, usually your HR system. CARI™ uses them to confirm shifts with crews and to compare scheduled against verified attendance.' },
];
---
<Base title="Integrations | CrewTeams" description="CrewTeams connects to your HR, payroll and ERP systems through open APIs: workers and schedules in, verified hours and labor cost out.">

  <!-- HERO -->
  <section class="i-hero">
    <div class="wrap i-hero-grid">
      <div>
        <p class="crumb"><a href="/platform/">Platform</a> <span>/</span> Integrations</p>
        <span class="cap-verb">Integrate</span>
        <h1>Works with the systems <span class="grad-text">you already run.</span></h1>
        <p class="lede">CrewTeams connects to your HR, payroll and ERP systems through open APIs. Workers and schedules come in. Verified hours and labor cost go out. Nobody types the same thing twice.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={site.demoUrl}>Request a Demo</a>
          <a class="btn btn-ghost" href="#flows">See what connects</a>
        </div>
      </div>

      <!-- Hub diagram -->
      <div class="hub" role="img" aria-label="CrewTeams connecting to HR, payroll and ERP systems">
        <div class="node n-hr"><strong>HR / HRIS</strong><span>workers · schedules →</span></div>
        <div class="node n-pay"><strong>Payroll</strong><span>← verified hours</span></div>
        <div class="node n-erp"><strong>ERP</strong><span>← labor cost · job codes →</span></div>
        <div class="node n-api"><strong>Your other systems</strong><span>open APIs</span></div>
        <div class="core"><img src="/img/icon.png" alt="" width="48" height="48" /><strong>CrewTeams</strong><span>CARI™</span></div>
        <svg class="spokes" viewBox="0 0 400 400" preserveAspectRatio="none" aria-hidden="true">
          <line x1="200" y1="200" x2="70" y2="70" /><line x1="200" y1="200" x2="330" y2="70" />
          <line x1="200" y1="200" x2="70" y2="330" /><line class="dash" x1="200" y1="200" x2="330" y2="330" />
        </svg>
      </div>
    </div>
  </section>

  <!-- PAIN -->
  <section class="section soft">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">The problem</span>
        <h2>Great data is useless if it’s stuck in the wrong system.</h2>
      </div>
      <div class="pains">
        {pains.map((p) => <article class="pain"><h3>{p.t}</h3><p>{p.d}</p></article>)}
      </div>
    </div>
  </section>

  <!-- FLOWS -->
  <section class="section" id="flows">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">What connects</span>
        <h2>What moves, and which way.</h2>
      </div>
      <div class="flows">
        {systems.map((s) => (
          <article class="flow">
            <div class="flow-top"><h3>{s.name}</h3><span class={`dir dir-${s.dir.toLowerCase()}`}>{s.dir === 'In' ? 'Into CrewTeams' : s.dir === 'Out' ? 'Out of CrewTeams' : 'Both ways'}</span></div>
            <p class="flow-lead">{s.lead}</p>
            <ul class="ticks">{s.flows.map((f) => <li>{f}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW -->
  <section class="section soft">
    <div class="wrap">
      <div class="head center">
        <span class="eyebrow">How we connect</span>
        <h2>Connected and tested before your first pay run.</h2>
      </div>
      <ol class="steps">
        {steps.map((s, i) => <li><span class="n">{i + 1}</span><h3>{s.t}</h3><p>{s.d}</p></li>)}
      </ol>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="wrap faq-wrap">
      <div>
        <span class="eyebrow">Common questions</span>
        <h2>What operators ask us about integrations.</h2>
      </div>
      <div class="faqs">
        {faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </div>
    </div>
  </section>

  <PageCTA title="Tell us what you run." text="Share your HR, payroll and ERP systems and we’ll show you exactly how CrewTeams connects to them." />
</Base>

<style>
  .i-hero { padding: 56px 0 64px; background: radial-gradient(1000px 420px at 90% -20%, rgba(26,138,80,.10), transparent 60%), radial-gradient(800px 420px at -10% 0%, rgba(30,99,165,.10), transparent 60%); }
  .i-hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 56px; align-items: center; }
  .i-hero h1 { font-size: clamp(2.1rem, 4.2vw, 3.2rem); text-wrap: balance; }
  .i-hero .lede { margin: 18px 0 28px; }
  .crumb { font-size: .9rem; color: var(--muted); margin: 0 0 16px; }
  .crumb a { color: var(--blue); text-decoration: none; font-weight: 500; }
  .crumb span { margin: 0 6px; color: var(--line); }
  .cap-verb { display: inline-block; font-size: .75rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--teal); background: #fff; border: 2px dashed var(--teal); padding: 3px 10px; border-radius: 999px; margin-bottom: 14px; }

  /* Hub */
  .hub { position: relative; aspect-ratio: 1; max-width: 440px; width: 100%; justify-self: center; }
  .spokes { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; }
  .spokes line { stroke: var(--teal); stroke-width: 3; }
  .spokes line.dash { stroke-dasharray: 8 7; }
  .core { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); z-index: 1; width: 38%; aspect-ratio: 1; border-radius: 50%; background: var(--ink); color: #fff; display: grid; place-items: center; align-content: center; gap: 2px; text-align: center; box-shadow: 0 0 0 10px rgba(14,122,150,.12), 0 20px 40px rgba(11,31,51,.25); }
  .core img { background: #fff; border-radius: 50%; }
  .core span { color: var(--gold); font-weight: 700; font-size: .8rem; }
  .node { position: absolute; z-index: 1; width: 42%; background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 12px 14px; box-shadow: var(--shadow); display: grid; gap: 2px; }
  .node strong { color: var(--ink); font-size: .95rem; }
  .node span { color: var(--muted); font-size: .78rem; }
  .n-hr { left: 0; top: 4%; }
  .n-pay { right: 0; top: 4%; }
  .n-erp { left: 0; bottom: 4%; }
  .n-api { right: 0; bottom: 4%; border-style: dashed; border-color: var(--teal); box-shadow: none; }

  .head { max-width: 760px; margin-bottom: 40px; }
  .head.center { margin-left: auto; margin-right: auto; text-align: center; }
  .head h2 { text-wrap: balance; }

  .pains { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .pain { background: #fff; border-radius: var(--radius); padding: 24px 22px; border-top: 4px solid #C8553D; box-shadow: 0 2px 10px rgba(11,31,51,.05); }
  .pain h3 { font-size: 1.1rem; }
  .pain p { margin: 0; color: var(--muted); font-size: .97rem; }

  .flows { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .flow { border: 1px solid var(--line); border-radius: 18px; padding: 26px 24px; }
  .flow-top { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 8px; }
  .flow-top h3 { margin: 0; font-size: 1.2rem; }
  .dir { font-size: .72rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; padding: 4px 10px; border-radius: 999px; }
  .dir-in { background: #E6F2EC; color: var(--green); }
  .dir-out { background: #E7EEF7; color: var(--blue-deep); }
  .dir-both { background: #FFF6E3; color: #9A6A00; }
  .flow-lead { color: var(--muted); }
  .ticks { list-style: none; padding: 0; margin: 12px 0 0; }
  .ticks li { position: relative; padding-left: 30px; margin-bottom: 12px; }
  .ticks li::before { content: ''; position: absolute; left: 0; top: .45em; width: 16px; height: 9px; border-left: 3px solid var(--green-bright); border-bottom: 3px solid var(--green-bright); transform: rotate(-45deg); }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; position: relative; }
  .steps::before { content: ''; position: absolute; top: 22px; left: 12%; right: 12%; height: 3px; background: var(--brand-grad); }
  .steps li { position: relative; text-align: center; padding: 0 6px; }
  .steps .n { position: relative; display: inline-grid; place-items: center; width: 46px; height: 46px; border-radius: 50%; background: #fff; border: 3px solid var(--teal); color: var(--ink); font-weight: 900; font-size: 1.1rem; margin-bottom: 14px; }
  .steps h3 { font-size: 1.05rem; }
  .steps p { margin: 0; color: var(--muted); font-size: .95rem; }

  .faq-wrap { display: grid; grid-template-columns: 1fr 1.4fr; gap: 56px; align-items: start; }
  .faq-wrap h2 { text-wrap: balance; }
  .faqs { display: grid; gap: 12px; }
  details { border: 1px solid var(--line); border-radius: 12px; padding: 0 20px; background: #fff; }
  summary { cursor: pointer; list-style: none; padding: 18px 28px 18px 0; font-weight: 700; color: var(--ink); position: relative; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: 0; top: 14px; font-size: 1.4rem; color: var(--teal); font-weight: 400; }
  details[open] summary::after { content: '–'; }
  details p { margin: 0 0 18px; color: var(--muted); }

  @media (max-width: 960px) {
    .i-hero-grid, .faq-wrap { grid-template-columns: 1fr; gap: 36px; }
    .flows, .pains { grid-template-columns: 1fr; }
    .steps { grid-template-columns: 1fr 1fr; row-gap: 32px; }
    .steps::before { display: none; }
    .section { padding: 72px 0; }
  }
  @media (max-width: 560px) {
    .steps { grid-template-columns: 1fr; }
    .steps li { text-align: left; display: grid; grid-template-columns: 46px 1fr; column-gap: 16px; }
    .steps .n { grid-row: span 2; margin: 0; }
    .i-hero { padding-top: 32px; }
    .node { padding: 8px 10px; }
    .node strong { font-size: .82rem; }
    .node span { font-size: .68rem; }
  }
</style>
