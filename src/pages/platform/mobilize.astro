---
import Base from '../../layouts/Base.astro';
import PageCTA from '../../components/PageCTA.astro';
import { site } from '../../data/site.js';

const pains = [
  { t: 'Crews don’t get the message', d: 'Shift changes and site updates get lost in group chats, voicemails and paper notices.' },
  { t: 'Supervisors become the help desk', d: 'The same questions about pay, shifts and paperwork, all day, by phone.' },
  { t: 'Language gets in the way', d: 'Instructions in one language for a crew that speaks three.' },
  { t: 'Paperwork lives in a truck', d: 'Cards, certificates and forms get lost, expire or never make it to the office.' },
];

const inApp = [
  { t: 'My shifts', d: 'Where and when they’re working, with site details, all in one place.' },
  { t: 'Clock in', d: 'Verified clock-in and clock-out with a face match, right from the app.' },
  { t: 'My pay', d: 'Hours, earnings and same-shift pay as soon as a shift is verified.' },
  { t: 'My credentials', d: 'What’s current and what’s expiring. Snap a photo of a renewed card to update it.' },
  { t: 'Recognition', d: 'Shout-outs and milestones tied to real performance, like on-time streaks.' },
  { t: 'Ask CARI™', d: 'Plain-language answers about pay, shifts and credentials, any time of day.' },
];

const connected = [
  { verb: 'Verify', t: 'Clock in where they already are', d: 'The verified punch happens inside Mobilize™, so there’s no separate time-clock app or hardware.', href: '/platform/time-attendance/' },
  { verb: 'Comply', t: 'Credentials stay current', d: 'Compliance Shield™ warns workers in the app before a card expires, and they update it with a photo.', href: '/platform/compliance-shield/' },
  { verb: 'Reward', t: 'Pay and recognition, visible', d: 'Workers see same-shift pay and their recognition in the same app, which is what brings them back.', href: '/platform/#reward' },
];

const faqs = [
  { q: 'Do workers have to download an app?', a: 'No. Workers without the app, or without data, still get messages and can talk to CARI™ by text. The app adds clock-in, pay and credentials in one place.' },
  { q: 'Which languages are supported?', a: 'Mobilize™ and CARI™ communicate with each worker in their own language, so a mixed crew can get the same update in the languages they actually speak.' },
  { q: 'Does it work on workers’ own phones?', a: 'Yes. Mobilize™ runs on the smartphones your crews already carry.' },
  { q: 'What do supervisors get?', a: 'Fewer calls. CARI™ handles the routine pay, shift and credential questions, and supervisors see who’s on site and who’s missing from one screen.' },
];
---
<Base title="Mobilize™ — The Crew App | CrewTeams" description="The crew app your frontline workers will actually open: shifts, clock-in, pay, credentials and recognition in their own language, with CARI™ built in.">

  <!-- HERO -->
  <section class="m-hero">
    <div class="wrap m-hero-grid">
      <div>
        <p class="crumb"><a href="/platform/">Platform</a> <span>/</span> Engage</p>
        <span class="cap-verb">Engage</span>
        <h1>The crew app your workers <span class="grad-text">will actually open.</span></h1>
        <p class="lede">Mobilize™ puts everything about a worker’s job on the phone already in their pocket: shifts, clock-in, pay, credentials and recognition, in their own language, with CARI™ built in.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={site.demoUrl}>Request a Demo</a>
          <a class="btn btn-ghost" href="#inside">See what’s inside</a>
        </div>
      </div>

      <!-- Phone mock: an example worker home screen -->
      <div class="phone-wrap">
        <div class="phone" role="img" aria-label="Example Mobilize app home screen">
          <div class="ph-top"><span>Hola, Luis</span><span class="lang">ES · EN</span></div>
          <div class="ph-card ph-shift">
            <small>Today’s shift</small>
            <strong>Site 14 · Concrete pour</strong>
            <span>6:30 AM – 3:00 PM</span>
            <div class="ph-btn">Clock in</div>
          </div>
          <div class="ph-row">
            <div class="ph-card ph-pay"><small>This week</small><strong>$1,184</strong><span>Same-shift pay on</span></div>
            <div class="ph-card ph-cred"><small>OSHA-10</small><strong>14 days</strong><span>Update card</span></div>
          </div>
          <div class="ph-card ph-rec"><span class="star">★</span><div><strong>30 on-time shifts</strong><small>Shout-out from Maria, your supervisor</small></div></div>
          <div class="ph-cari"><img src="/img/icon.png" alt="" width="22" height="22" />Ask CARI™ anything…</div>
        </div>
      </div>
    </div>
  </section>

  <!-- PAIN -->
  <section class="section soft">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">The problem</span>
        <h2>Your crews aren’t at a desk, so most software never reaches them.</h2>
        <p class="lede">Email, intranets and HR portals were built for office workers. Frontline crews get group texts, clipboards and a supervisor’s cell phone.</p>
      </div>
      <div class="pains">
        {pains.map((p) => <article class="pain"><h3>{p.t}</h3><p>{p.d}</p></article>)}
      </div>
    </div>
  </section>

  <!-- INSIDE THE APP -->
  <section class="section" id="inside">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">Inside Mobilize™</span>
        <h2>Everything about their job. One app. Their language.</h2>
      </div>
      <div class="feats">
        {inApp.map((f) => <article class="feat"><h3>{f.t}</h3><p>{f.d}</p></article>)}
      </div>
    </div>
  </section>

  <!-- NO APP NEEDED -->
  <section class="section dark">
    <div class="wrap sms">
      <div>
        <span class="eyebrow">No app? No problem.</span>
        <h2>Every worker is reachable, even without the app.</h2>
        <p class="lede">Not everyone will download an app on day one. CARI™ reaches every worker by text message, in their language, so nobody misses a shift change, a credential reminder or a pay update.</p>
      </div>
      <div class="sms-facts">
        <div><span class="num">95%</span><span>of CARI™ texts read within 3 minutes</span></div>
        <div><span class="num">0</span><span>downloads needed to start</span></div>
      </div>
    </div>
  </section>

  <!-- CONNECTED -->
  <section class="section">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">Connected, not standalone</span>
        <h2>The front door to the whole platform.</h2>
        <p class="lede">Mobilize™ is where workers meet every other part of CrewTeams, because everything about them lives in one place.</p>
      </div>
      <div class="conn">
        {connected.map((c) => (
          <a class="conn-card" href={c.href}>
            <span class="cap-verb sm">{c.verb}</span>
            <h3>{c.t}</h3>
            <p>{c.d}</p>
            <span class="more">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section soft">
    <div class="wrap faq-wrap">
      <div>
        <span class="eyebrow">Common questions</span>
        <h2>What operators ask us about the crew app.</h2>
      </div>
      <div class="faqs">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <PageCTA title="Put Mobilize™ in one crew’s hands." text="We’ll set up a crew at one of your sites and show you what they see: shifts, clock-in, pay and credentials, in their language." />
</Base>

<style>
  .m-hero { padding: 56px 0 64px; background: radial-gradient(1000px 420px at 90% -20%, rgba(26,138,80,.10), transparent 60%), radial-gradient(800px 420px at -10% 0%, rgba(30,99,165,.10), transparent 60%); }
  .m-hero-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 56px; align-items: center; }
  .m-hero h1 { font-size: clamp(2.1rem, 4.2vw, 3.2rem); text-wrap: balance; }
  .m-hero .lede { margin: 18px 0 28px; }
  .crumb { font-size: .9rem; color: var(--muted); margin: 0 0 16px; }
  .crumb a { color: var(--blue); text-decoration: none; font-weight: 500; }
  .crumb span { margin: 0 6px; color: var(--line); }
  .cap-verb { display: inline-block; font-size: .75rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: #fff; background: var(--brand-grad); padding: 4px 11px; border-radius: 999px; margin-bottom: 14px; }
  .cap-verb.sm { margin-bottom: 12px; }

  /* Phone mock */
  .phone-wrap { display: flex; justify-content: center; }
  .phone { width: 320px; max-width: 100%; background: #0F2A44; border-radius: 40px; padding: 22px 16px 18px; box-shadow: 0 40px 80px rgba(11,31,51,.3), inset 0 0 0 8px #13304D; display: grid; gap: 10px; font-size: .9rem; }
  .ph-top { display: flex; justify-content: space-between; align-items: center; color: #fff; font-weight: 700; font-size: 1.1rem; padding: 4px 6px 2px; }
  .lang { font-size: .7rem; font-weight: 700; letter-spacing: .08em; color: var(--gold); border: 1px solid rgba(240,168,30,.5); border-radius: 999px; padding: 2px 8px; }
  .ph-card { background: #fff; border-radius: 16px; padding: 12px 14px; display: grid; gap: 2px; }
  .ph-card small { color: var(--muted); font-size: .75rem; }
  .ph-card strong { color: var(--ink); }
  .ph-card span { color: var(--muted); font-size: .8rem; }
  .ph-shift strong { font-size: 1.05rem; }
  .ph-btn { margin-top: 8px; background: var(--brand-grad); color: #fff; text-align: center; font-weight: 700; border-radius: 12px; padding: 10px; }
  .ph-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .ph-pay strong { font-size: 1.3rem; font-weight: 900; font-variant-numeric: tabular-nums; }
  .ph-pay span { color: var(--green); font-weight: 700; }
  .ph-cred { background: #FFF6E3; }
  .ph-cred strong { font-size: 1.3rem; font-weight: 900; color: #A5402B; }
  .ph-cred span { color: var(--blue); font-weight: 700; }
  .ph-rec { grid-template-columns: 28px 1fr; align-items: center; gap: 10px; }
  .ph-rec .star { color: var(--gold); font-size: 1.4rem; }
  .ph-rec strong { display: block; }
  .ph-cari { display: flex; align-items: center; gap: 8px; background: #1B3D5E; color: #AFC0D2; border-radius: 999px; padding: 10px 14px; }
  .ph-cari img { background: #fff; border-radius: 50%; }

  .head { max-width: 760px; margin-bottom: 40px; }
  .head h2 { text-wrap: balance; }

  .pains { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .pain { background: #fff; border-radius: var(--radius); padding: 24px 22px; border-top: 4px solid #C8553D; box-shadow: 0 2px 10px rgba(11,31,51,.05); }
  .pain h3 { font-size: 1.1rem; }
  .pain p { margin: 0; color: var(--muted); font-size: .97rem; }

  .feats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .feat { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 24px 22px; }
  .feat h3 { font-size: 1.05rem; }
  .feat p { margin: 0; color: var(--muted); font-size: .95rem; }

  .sms { display: grid; grid-template-columns: 1.4fr 1fr; gap: 64px; align-items: center; }
  .sms h2 { text-wrap: balance; }
  .sms-facts { display: grid; gap: 14px; }
  .sms-facts > div { background: var(--ink-2); border-radius: 14px; padding: 22px; display: grid; gap: 4px; color: #AFC0D2; }
  .sms-facts .num { font-size: 2.2rem; font-weight: 900; color: #fff; line-height: 1; }

  .conn { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .conn-card { display: block; text-decoration: none; color: inherit; border: 1px solid var(--line); border-radius: var(--radius); padding: 26px 24px; transition: box-shadow .15s, transform .15s; }
  .conn-card:hover { box-shadow: var(--shadow); transform: translateY(-2px); }
  .conn-card h3 { font-size: 1.1rem; }
  .conn-card p { color: var(--muted); font-size: .95rem; margin: 0 0 14px; }
  .more { font-weight: 700; color: var(--blue); font-size: .95rem; }

  .faq-wrap { display: grid; grid-template-columns: 1fr 1.4fr; gap: 56px; align-items: start; }
  .faq-wrap h2 { text-wrap: balance; }
  .faqs { display: grid; gap: 12px; }
  details { border: 1px solid var(--line); border-radius: 12px; padding: 0 20px; background: #fff; }
  summary { cursor: pointer; list-style: none; padding: 18px 28px 18px 0; font-weight: 700; color: var(--ink); position: relative; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: 0; top: 14px; font-size: 1.4rem; color: var(--teal); font-weight: 400; }
  details[open] summary::after { content: '–'; }
  details p { margin: 0 0 18px; color: var(--muted); }

  @media (max-width: 960px) {
    .m-hero-grid, .faq-wrap, .sms { grid-template-columns: 1fr; gap: 36px; }
    .pains { grid-template-columns: 1fr 1fr; }
    .feats, .conn { grid-template-columns: 1fr 1fr; }
    .section { padding: 72px 0; }
  }
  @media (max-width: 560px) {
    .pains, .feats, .conn { grid-template-columns: 1fr; }
    .m-hero { padding-top: 32px; }
  }
</style>
