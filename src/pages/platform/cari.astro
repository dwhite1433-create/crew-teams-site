---
import Base from '../../layouts/Base.astro';
import PageCTA from '../../components/PageCTA.astro';
import { site } from '../../data/site.js';

const inputs = ['Verified identity', 'Credentials & training', 'Schedules', 'Attendance', 'Labor rules', 'Pay & recognition'];
const outputs = [
  { who: 'Workers', what: 'Answers and reminders, by text or in the app, in their language' },
  { who: 'Supervisors', what: 'Who’s on site, who’s missing and what needs attention' },
  { who: 'Operations & HR', what: 'Compliance issues flagged before they become problems' },
];

const does = [
  { t: 'Answers questions', d: 'Pay, shifts, credentials and site details, in plain language, any time of day. Supervisors stop being the help desk.' },
  { t: 'Flags issues early', d: 'An expiring card, a missing punch or an hour that breaks a rule gets flagged before it becomes a fine, a gap or a grievance.' },
  { t: 'Follows up on its own', d: 'CARI doesn’t wait to be asked. It sends the reminder, asks for the renewed card and tells the supervisor when something needs a person.' },
  { t: 'Speaks every worker’s language', d: 'A mixed crew gets the same message in the languages they actually speak.' },
];

const agentic = [
  { t: 'You set the rules', d: 'CARI works inside the credential requirements, labor rules and permissions you define for each site and role.' },
  { t: 'It acts, then reports', d: 'Routine follow-ups happen automatically. Anything that needs a decision goes to the right person.' },
  { t: 'Everything is logged', d: 'Every message and action CARI takes is recorded, so you can see what happened and why.' },
];

const faqs = [
  { q: 'Is CARI™ just a chatbot?', a: 'No. A chatbot waits for questions. CARI™ also acts: it sends reminders, follows up on missing punches and expiring credentials, and alerts supervisors, using everything CrewTeams knows about each worker.' },
  { q: 'How do workers reach CARI™?', a: 'By text message or inside the Mobilize™ app. Nothing to download to get started, and 95% of CARI™ texts are read within 3 minutes.' },
  { q: 'Does CARI™ make decisions on its own?', a: 'Only within the rules you set. Routine follow-ups are automatic; anything that needs judgment goes to a supervisor or your team.' },
];
---
<Base title="CARI™ Agentic AI | CrewTeams" description="CARI™ is the connected foundation under every CrewTeams capability: it answers workers and supervisors, flags issues early and follows up on its own, by text, in every worker's language.">

  <!-- HERO -->
  <section class="a-hero">
    <div class="wrap a-hero-grid">
      <div>
        <p class="crumb"><a href="/platform/">Platform</a> <span>/</span> CARI™</p>
        <span class="cap-verb">Agentic AI</span>
        <h1>CARI™: the AI your crews <span class="grad-text">actually talk to.</span></h1>
        <p class="lede">CARI™ sits underneath every CrewTeams capability. It uses everything about every worker, all in one place, to answer questions, flag problems early and follow up on its own, by text, in each worker’s language.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={site.demoUrl}>Request a Demo</a>
          <a class="btn btn-ghost" href="#curates">See how CARI works</a>
        </div>
      </div>

      <!-- Two example conversations: worker and supervisor -->
      <div class="convos">
        <div class="phone" role="img" aria-label="Example CARI conversation with a worker">
          <div class="ph-bar"><img src="/img/icon.png" alt="" width="24" height="24" /> CARI™ · Luis</div>
          <div class="msg in">Your OSHA-10 expires in 14 days. Reply with a photo of your renewed card and I’ll update your record.</div>
          <div class="msg out">Will do tonight. Did I get paid for Tuesday?</div>
          <div class="msg in">Yes. Tuesday at Site 14 is verified, 8.5 hours. $184 was sent this morning.</div>
        </div>
        <div class="phone sup" role="img" aria-label="Example CARI conversation with a supervisor">
          <div class="ph-bar"><img src="/img/icon.png" alt="" width="24" height="24" /> CARI™ · Maria (supervisor)</div>
          <div class="msg out">Who’s missing at Site 14?</div>
          <div class="msg in">19 of 21 are clocked in. J. Ortiz is blocked: forklift cert expired. R. Díaz hasn’t punched yet; I texted him at 6:40.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW CARI CURATES -->
  <section class="section soft" id="curates">
    <div class="wrap">
      <div class="head center">
        <span class="eyebrow">The connected foundation</span>
        <h2>Everything in one place in. The next right action out.</h2>
        <p class="lede">Because every capability shares one place for every worker, CARI™ sees the whole picture and decides what each person needs to know next.</p>
      </div>
      <div class="flow">
        <div class="flow-col">
          <p class="flow-label">What CARI™ knows</p>
          <ul class="chips">{inputs.map((i) => <li>{i}</li>)}</ul>
        </div>
        <div class="flow-arrow" aria-hidden="true"></div>
        <div class="flow-core">
          <img src="/img/icon.png" alt="" width="56" height="56" />
          <strong>CARI™</strong>
          <span>Curates, decides, follows up</span>
        </div>
        <div class="flow-arrow" aria-hidden="true"></div>
        <div class="flow-col">
          <p class="flow-label">Who hears from CARI™</p>
          {outputs.map((o) => <div class="out"><strong>{o.who}</strong><span>{o.what}</span></div>)}
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT CARI DOES -->
  <section class="section">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">What CARI™ does</span>
        <h2>Less chasing. Fewer surprises.</h2>
      </div>
      <div class="does">
        {does.map((d) => <article class="do"><h3>{d.t}</h3><p>{d.d}</p></article>)}
      </div>
    </div>
  </section>

  <!-- AGENTIC, IN PLAIN TERMS -->
  <section class="section dark">
    <div class="wrap ag">
      <div>
        <span class="eyebrow">What “agentic” means here</span>
        <h2>An AI that does the follow-up, inside the rules you set.</h2>
        <p class="lede">Most AI tools answer questions. CARI™ also takes the next step: the reminder, the follow-up, the heads-up to a supervisor. You stay in control of what it’s allowed to do.</p>
        <div class="stat"><span class="num">95%</span><span>of CARI™ texts read within 3 minutes</span></div>
      </div>
      <div class="ag-list">
        {agentic.map((a) => <article><h3>{a.t}</h3><p>{a.d}</p></article>)}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="wrap faq-wrap">
      <div>
        <span class="eyebrow">Common questions</span>
        <h2>What operators ask us about CARI™.</h2>
      </div>
      <div class="faqs">
        {faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </div>
    </div>
  </section>

  <PageCTA title="Talk to CARI™ yourself." text="We’ll text you as a worker and as a supervisor at one of your sites, so you can see what your crews would see." />
</Base>

<style>
  .a-hero { padding: 56px 0 64px; background: radial-gradient(1000px 420px at 90% -20%, rgba(26,138,80,.10), transparent 60%), radial-gradient(800px 420px at -10% 0%, rgba(30,99,165,.10), transparent 60%); }
  .a-hero-grid { display: grid; grid-template-columns: 1fr 1.05fr; gap: 56px; align-items: center; }
  .a-hero h1 { font-size: clamp(2.1rem, 4.2vw, 3.2rem); text-wrap: balance; }
  .a-hero .lede { margin: 18px 0 28px; }
  .crumb { font-size: .9rem; color: var(--muted); margin: 0 0 16px; }
  .crumb a { color: var(--blue); text-decoration: none; font-weight: 500; }
  .crumb span { margin: 0 6px; color: var(--line); }
  .cap-verb { display: inline-block; font-size: .75rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--ink); background: var(--gold); padding: 4px 11px; border-radius: 999px; margin-bottom: 14px; }

  /* Conversations */
  .convos { display: grid; gap: 16px; }
  .phone { background: #0F2A44; border-radius: 24px; padding: 18px; box-shadow: 0 30px 60px rgba(11,31,51,.25); display: grid; gap: 8px; max-width: 420px; width: 100%; }
  .phone.sup { justify-self: end; background: var(--ink); }
  .ph-bar { display: flex; align-items: center; gap: 8px; color: #fff; font-weight: 700; font-size: .9rem; padding-bottom: 10px; border-bottom: 1px solid rgba(255,255,255,.1); margin-bottom: 4px; }
  .ph-bar img { background: #fff; border-radius: 50%; }
  .msg { padding: 10px 13px; border-radius: 14px; font-size: .9rem; max-width: 88%; line-height: 1.45; }
  .msg.in { background: #1B3D5E; color: #E6EEF6; border-bottom-left-radius: 4px; }
  .msg.out { background: var(--brand-grad); color: #fff; margin-left: auto; border-bottom-right-radius: 4px; }

  .head { max-width: 760px; margin-bottom: 40px; }
  .head.center { margin-left: auto; margin-right: auto; text-align: center; }
  .head h2 { text-wrap: balance; }

  /* Flow */
  .flow { display: grid; grid-template-columns: 1fr 48px auto 48px 1fr; align-items: center; gap: 12px; }
  .flow-col { background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 22px; }
  .flow-label { font-size: .75rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin: 0 0 12px; }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips li { background: var(--bg-soft); border: 1px solid var(--line); border-radius: 999px; padding: 6px 12px; font-size: .9rem; color: var(--ink); font-weight: 500; }
  .flow-arrow { height: 3px; background: var(--brand-grad); position: relative; border-radius: 2px; }
  .flow-arrow::after { content: ''; position: absolute; right: -2px; top: -6px; border-left: 10px solid var(--green-bright); border-top: 7.5px solid transparent; border-bottom: 7.5px solid transparent; }
  .flow-core { background: var(--ink); color: #fff; border-radius: 50%; width: 190px; height: 190px; display: grid; place-items: center; align-content: center; gap: 4px; text-align: center; box-shadow: 0 0 0 10px rgba(14,122,150,.12), 0 20px 40px rgba(11,31,51,.25); }
  .flow-core img { background: #fff; border-radius: 50%; }
  .flow-core strong { font-size: 1.3rem; }
  .flow-core span { font-size: .8rem; color: var(--gold); font-weight: 700; padding: 0 18px; }
  .out { display: grid; gap: 2px; padding: 10px 0; border-top: 1px solid var(--line); }
  .out:first-of-type { border-top: 0; padding-top: 0; }
  .out strong { color: var(--ink); }
  .out span { color: var(--muted); font-size: .92rem; }

  /* Does */
  .does { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
  .do { border: 1px solid var(--line); border-radius: var(--radius); padding: 24px 22px; border-top: 4px solid var(--teal); }
  .do h3 { font-size: 1.08rem; }
  .do p { margin: 0; color: var(--muted); font-size: .95rem; }

  /* Agentic */
  .ag { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; }
  .ag h2 { text-wrap: balance; }
  .stat { margin-top: 28px; display: grid; gap: 4px; color: #AFC0D2; }
  .stat .num { font-size: 2.6rem; font-weight: 900; line-height: 1; color: #fff; }
  .ag-list { display: grid; gap: 12px; }
  .ag-list article { background: var(--ink-2); border: 1px solid rgba(255,255,255,.08); border-radius: 14px; padding: 20px 22px; }
  .ag-list h3 { font-size: 1.05rem; margin-bottom: 4px; }
  .ag-list p { margin: 0; color: #AFC0D2; font-size: .95rem; }

  .faq-wrap { display: grid; grid-template-columns: 1fr 1.4fr; gap: 56px; align-items: start; }
  .faq-wrap h2 { text-wrap: balance; }
  .faqs { display: grid; gap: 12px; }
  details { border: 1px solid var(--line); border-radius: 12px; padding: 0 20px; background: #fff; }
  summary { cursor: pointer; list-style: none; padding: 18px 28px 18px 0; font-weight: 700; color: var(--ink); position: relative; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: 0; top: 14px; font-size: 1.4rem; color: var(--teal); font-weight: 400; }
  details[open] summary::after { content: '–'; }
  details p { margin: 0 0 18px; color: var(--muted); }

  @media (max-width: 960px) {
    .a-hero-grid, .faq-wrap, .ag { grid-template-columns: 1fr; gap: 36px; }
    .does { grid-template-columns: 1fr 1fr; }
    .flow { grid-template-columns: 1fr; justify-items: center; }
    .flow-col { width: 100%; }
    .flow-arrow { width: 3px; height: 36px; }
    .flow-arrow::after { right: -6px; top: auto; bottom: -2px; border-left: 7.5px solid transparent; border-right: 7.5px solid transparent; border-top: 10px solid var(--green-bright); border-bottom: 0; }
    .phone.sup { justify-self: start; }
    .section { padding: 72px 0; }
  }
  @media (max-width: 560px) {
    .does { grid-template-columns: 1fr; }
    .a-hero { padding-top: 32px; }
    .flow-core { width: 160px; height: 160px; }
  }
</style>
