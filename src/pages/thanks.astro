---
import Base from '../layouts/Base.astro';
---

<Base title="Thanks — CrewTeams" description="Thanks for your interest in CrewTeams.">
  <section class="section">
    <div class="container center">
      <span class="eyebrow">Request received</span>
      <h1>Thanks! We'll be in touch.</h1>
      <p>A member of the CrewTeams team will reach out within one business day to schedule your demo.</p>
      <a class="btn btn-primary" href="/">Back to home</a>
    </div>
  </section>
</Base>

<style>
  .center { text-align: center; max-width: 640px; }
  p { color: var(--ink-soft); font-size: 1.1rem; margin-bottom: 28px; }
</style>
