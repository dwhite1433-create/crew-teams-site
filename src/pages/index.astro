---
import Base from '../layouts/Base.astro';
import { capabilities, site } from '../data/site.js';

const industries = ['Construction', 'Industrial Cleaning', 'Manufacturing', 'Security Services', 'Transportation & Logistics'];

const pillars = [
  {
    step: 'Engage',
    title: 'Crew Experience & Retention',
    text: 'A mobile-first platform powered by offline-capable biometrics, agentic AI, motivation science and instant pay. Workers control their schedules, credentials, rewards and career progression.',
  },
  {
    step: 'Predict',
    title: 'Demand-Driven Staffing Intelligence',
    text: 'AI forecasts staffing from live demand — project schedules, routes, site activity — rather than last year’s patterns, cutting gaps and overtime before they happen.',
  },
  {
    step: 'Orchestrate',
    title: 'Dynamic Labor Command & Control',
    text: 'Continuous optimization that puts the right worker in the right place at the right time, weighing skills, credentials, preferences, compliance rules and real-time demand.',
  },
];
---
<Base title="CrewTeams — The workforce platform for frontline crews">
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Powered by CARI™ agentic AI</span>
        <h1>The workforce platform your crews would <span class="grad-text">build for themselves.</span></h1>
        <p class="lede">One platform for the frontline workers who keep the physical economy running — fusing biometric time &amp; attendance, motivation science and agentic AI. Built for job sites, not desks.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={site.demoUrl}>Request a Demo</a>
          <a class="btn btn-ghost" href="/platform/">Explore the Platform</a>
        </div>
      </div>
      <div class="hero-media">
        <img src="/img/hero-biometrics.jpg" alt="Construction worker verifying his shift with facial biometrics on a phone at a job site" width="1800" height="982" />
        <div class="chip chip-verify">
          <span class="dot"></span>
          <div><strong>Shift verified</strong><small>Face + liveness · inside site geofence</small></div>
        </div>
        <div class="chip chip-pay">
          <strong>Same-shift pay</strong><small>Sent after clock-out</small>
        </div>
      </div>
    </div>
  </section>

  <!-- INDUSTRIES STRIP -->
  <section class="industries">
    <div class="wrap">
      <p>Built for the crews behind</p>
      <ul>{industries.map((i) => <li>{i}</li>)}</ul>
    </div>
  </section>

  <!-- VISION / STATS -->
  <section class="section">
    <div class="wrap vision">
      <div>
        <span class="eyebrow">Why CrewTeams</span>
        <h2>80% of the world’s workforce still runs on spreadsheets and punch clocks.</h2>
        <p class="lede">Frontline crews in construction, logistics, manufacturing, cleaning and security make up most of the global workforce, yet they’ve been left out of modern workforce software. CrewTeams is built for them first.</p>
      </div>
      <div class="stats">
        <div class="stat"><span class="num grad-text">2.7B</span><span>frontline workers worldwide</span></div>
        <div class="stat"><span class="num grad-text">80%</span><span>of the global workforce</span></div>
        <div class="stat"><span class="num grad-text">95%</span><span>of CARI™ texts read within 3 minutes</span></div>
        <div class="stat"><span class="num grad-text">90 sec</span><span>just-in-time learning moments</span></div>
      </div>
    </div>
  </section>

  <!-- ENGAGE PREDICT ORCHESTRATE -->
  <section class="section soft">
    <div class="wrap">
      <div class="center">
        <span class="eyebrow">The operating model</span>
        <h2>Engage. Predict. Orchestrate.</h2>
        <p class="lede">Three connected moves that turn a scattered crew into a coordinated workforce.</p>
      </div>
      <div class="pillars">
        {pillars.map((p, i) => (
          <article class="pillar">
            <div class="pillar-step"><span>{String(i + 1).padStart(2, '0')}</span>{p.step}</div>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CAPABILITIES -->
  <section class="section" id="capabilities">
    <div class="wrap">
      <div class="cap-head">
        <div>
          <span class="eyebrow">The platform</span>
          <h2>Eight capabilities. One platform.</h2>
        </div>
        <p class="lede">Every capability shares the same worker record, the same rules and the same AI, so nothing falls between systems.</p>
      </div>
      <div class="caps">
        {capabilities.map((c) => (
          <article class="cap">
            <div class="cap-top"><span class="cap-n">{c.n}</span><span class="cap-verb">{c.verb}</span></div>
            <h3>{c.name}</h3>
            <p>{c.text}</p>
          </article>
        ))}
      </div>
      <div class="center" style="margin-top:40px"><a class="btn btn-ghost" href="/platform/">See the full platform</a></div>
    </div>
  </section>

  <!-- CARI -->
  <section class="section dark">
    <div class="wrap cari">
      <div>
        <span class="eyebrow">The intelligence layer</span>
        <h2>Meet CARI™, the agentic AI that runs alongside your crews.</h2>
        <p class="lede">CARI curates each worker’s experience, builds the rules, generates the dashboards, monitors compliance and orchestrates labor in real time. It reaches crews by text message, so no one has to download anything to get started.</p>
        <ul class="ticks">
          <li>Plain-language answers for supervisors and workers</li>
          <li>Proactive alerts before a no-show becomes a gap</li>
          <li>Works in each worker’s language</li>
        </ul>
      </div>
      <div class="phone" aria-label="Example CARI text conversation">
        <div class="phone-bar"><img src="/img/icon.png" alt="" width="28" height="28" /> CARI™</div>
        <div class="msg in">Morning Luis — tomorrow’s pour at Site 14 starts at 5:30 AM. Can you take the extra shift? It pays time-and-a-half.</div>
        <div class="msg out">Yes, I’m in.</div>
        <div class="msg in">Done. You’re confirmed, and your OSHA-10 is current. I’ll send the safety brief tonight.</div>
        <div class="msg-meta">Read · 1 min</div>
      </div>
    </div>
  </section>

  <!-- BUILT FOR THE FIELD -->
  <section class="section">
    <div class="wrap field">
      <div class="field-media">
        <img class="f1" src="/img/crew-site.jpg" alt="Road construction crew in high-visibility vests on a job site" width="800" height="533" />
        <img class="f2" src="/img/cleaning-lead.jpg" alt="Industrial cleaning team lead reviewing live site status" width="900" height="900" />
      </div>
      <div>
        <span class="eyebrow">Built for job sites, not desks</span>
        <h2>Works where your crews actually work.</h2>
        <p class="lede">From a remote pipeline to a night shift at a plant, CrewTeams is designed for patchy signal, shared devices, many languages and union rules.</p>
        <ul class="ticks dark-ticks">
          <li><strong>Offline biometrics</strong> — verified punches even with no signal</li>
          <li><strong>Geofenced sites</strong> — attendance tied to the actual job location</li>
          <li><strong>Union &amp; CBA aware</strong> — rules enforced automatically</li>
          <li><strong>Built on certified technology</strong> — proven time &amp; attendance, localized for the U.S. and Canada</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="wrap cta-inner">
      <div>
        <h2>See CrewTeams on your crews’ day.</h2>
        <p>We’ll walk through a shift at one of your sites, from verified clock-in to same-shift pay.</p>
      </div>
      <div class="btn-row">
        <a class="btn btn-light" href={site.demoUrl}>Request a Demo</a>
        <a class="btn btn-outline-light" href={`mailto:${site.email}`}>Email us</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero { padding: 72px 0 56px; background: radial-gradient(1200px 500px at 85% -10%, rgba(26,138,80,.10), transparent 60%), radial-gradient(900px 500px at -10% 10%, rgba(30,99,165,.10), transparent 60%); }
  .hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 56px; align-items: center; }
  .hero-copy .lede { margin: 18px 0 30px; }
  .hero-media { position: relative; }
  .hero-media img { border-radius: 22px; box-shadow: 0 30px 60px rgba(11,31,51,.18); aspect-ratio: 4/3.4; object-fit: cover; object-position: 55% center; width: 100%; }
  .chip { position: absolute; background: #fff; border-radius: 14px; box-shadow: var(--shadow); padding: 12px 16px; display: flex; gap: 10px; align-items: center; font-size: .9rem; }
  .chip strong { display: block; color: var(--ink); }
  .chip small { color: var(--muted); }
  .chip-verify { left: -28px; bottom: 36px; }
  .chip-pay { right: -18px; top: 28px; flex-direction: column; align-items: flex-start; gap: 0; border-left: 4px solid var(--gold); }
  .dot { width: 12px; height: 12px; border-radius: 50%; background: var(--green-bright); box-shadow: 0 0 0 5px rgba(42,145,86,.18); flex: none; }

  /* Industries strip */
  .industries { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 22px 0; }
  .industries .wrap { display: flex; align-items: center; gap: 28px; flex-wrap: wrap; justify-content: center; }
  .industries p { margin: 0; color: var(--muted); font-size: .9rem; text-transform: uppercase; letter-spacing: .12em; font-weight: 500; }
  .industries ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px 28px; justify-content: center; }
  .industries li { font-weight: 700; color: var(--ink); }

  /* Vision */
  .vision { display: grid; grid-template-columns: 1.2fr 1fr; gap: 64px; align-items: center; }
  .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .stat { background: var(--bg-soft); border-radius: var(--radius); padding: 26px 22px; display: flex; flex-direction: column; gap: 4px; color: var(--muted); font-size: .95rem; }
  .num { font-size: 2.6rem; font-weight: 900; line-height: 1; }

  /* Pillars */
  .pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 48px; }
  .pillar { background: #fff; border-radius: var(--radius); padding: 32px 28px; box-shadow: var(--shadow); border-top: 4px solid; border-image: var(--brand-grad) 1; }
  .pillar-step { display: flex; align-items: center; gap: 10px; font-weight: 900; font-size: 1.5rem; color: var(--blue-deep); margin-bottom: 12px; }
  .pillar:nth-child(2) .pillar-step { color: var(--teal); }
  .pillar:nth-child(3) .pillar-step { color: var(--green); }
  .pillar-step span { font-size: .8rem; font-weight: 700; color: var(--muted); border: 1px solid var(--line); border-radius: 999px; padding: 2px 9px; }
  .pillar p { color: var(--muted); margin: 0; }

  /* Capabilities */
  .cap-head { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: end; margin-bottom: 40px; }
  .cap-head .lede { margin: 0; }
  .caps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
  .cap { border: 1px solid var(--line); border-radius: var(--radius); padding: 24px 22px; transition: border-color .15s, box-shadow .15s, transform .15s; background: #fff; }
  .cap:hover { border-color: transparent; box-shadow: var(--shadow); transform: translateY(-2px); }
  .cap-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; }
  .cap-n { font-weight: 900; font-size: 1.4rem; color: var(--line); }
  .cap-verb { font-size: .75rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: #fff; background: var(--brand-grad); padding: 4px 10px; border-radius: 999px; }
  .cap h3 { font-size: 1.05rem; }
  .cap p { color: var(--muted); font-size: .95rem; margin: 0; }

  /* CARI */
  .cari { display: grid; grid-template-columns: 1.2fr 1fr; gap: 64px; align-items: center; }
  .ticks { list-style: none; padding: 0; margin: 24px 0 0; }
  .ticks li { position: relative; padding-left: 30px; margin-bottom: 12px; }
  .ticks li::before { content: ''; position: absolute; left: 0; top: .45em; width: 16px; height: 9px; border-left: 3px solid var(--gold); border-bottom: 3px solid var(--gold); transform: rotate(-45deg); }
  .dark-ticks li::before { border-color: var(--green-bright); }
  .phone { background: #0F2A44; border: 1px solid rgba(255,255,255,.08); border-radius: 28px; padding: 22px; max-width: 380px; justify-self: center; width: 100%; box-shadow: 0 30px 60px rgba(0,0,0,.35); }
  .phone-bar { display: flex; align-items: center; gap: 10px; color: #fff; font-weight: 700; padding-bottom: 14px; border-bottom: 1px solid rgba(255,255,255,.1); margin-bottom: 16px; }
  .phone-bar img { border-radius: 50%; background: #fff; }
  .msg { padding: 12px 14px; border-radius: 16px; margin-bottom: 10px; font-size: .95rem; max-width: 85%; line-height: 1.45; }
  .msg.in { background: #1B3D5E; color: #E6EEF6; border-bottom-left-radius: 4px; }
  .msg.out { background: var(--brand-grad); color: #fff; margin-left: auto; border-bottom-right-radius: 4px; }
  .msg-meta { text-align: right; font-size: .75rem; color: #7F95AB; }

  /* Field */
  .field { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
  .field-media { position: relative; padding-bottom: 60px; }
  .field-media img { border-radius: 18px; object-fit: cover; }
  .f1 { width: 88%; aspect-ratio: 4/3; }
  .f2 { position: absolute; right: 0; bottom: 0; width: 46%; aspect-ratio: 1; border: 6px solid #fff; box-shadow: var(--shadow); }

  /* CTA */
  .cta { background: var(--brand-grad); color: #fff; padding: 72px 0; }
  .cta h2 { color: #fff; margin-bottom: .3em; }
  .cta p { margin: 0; opacity: .9; font-size: 1.1rem; }
  .cta-inner { display: flex; justify-content: space-between; align-items: center; gap: 32px; flex-wrap: wrap; }

  @media (max-width: 960px) {
    .hero-grid, .vision, .cari, .field, .cap-head { grid-template-columns: 1fr; gap: 40px; }
    .pillars { grid-template-columns: 1fr; }
    .caps { grid-template-columns: 1fr 1fr; }
    .chip-verify { left: 12px; }
    .chip-pay { right: 12px; }
    .section { padding: 72px 0; }
  }
  @media (max-width: 560px) {
    .caps { grid-template-columns: 1fr; }
    .stats { grid-template-columns: 1fr 1fr; }
    .num { font-size: 2rem; }
    .chip-pay { display: none; }
    .chip-verify { left: 10px; bottom: 10px; padding: 8px 12px; font-size: .8rem; }
    .hero { padding-top: 40px; }
  }
</style>
