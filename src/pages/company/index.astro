---
import Base from '../../layouts/Base.astro';
import PageCTA from '../../components/PageCTA.astro';
import { site } from '../../data/site.js';

const beliefs = [
  { t: 'Built for job sites, not desks', d: 'If it doesn’t work with patchy signal, gloves on and a crew that speaks three languages, it doesn’t ship.' },
  { t: 'Workers first', d: 'We build the app crews would build for themselves: their shifts, their pay, their recognition, in their language.' },
  { t: 'Verified, not assumed', d: 'Every hour, credential and payment should be backed by proof, not a clipboard or a best guess.' },
  { t: 'Privacy by design', d: 'Biometric and personal data are handled with consent, used only for their purpose and deleted when they’re no longer needed.' },
];

const industries = ['Construction', 'Industrial Cleaning', 'Manufacturing', 'Security Services', 'Transportation & Logistics'];
---
<Base title="Company | CrewTeams" description="CrewTeams builds the workforce platform for the crews who keep the physical economy running. Our story, what we believe and how to reach us.">

  <!-- HERO -->
  <section class="co-hero">
    <div class="wrap">
      <span class="eyebrow">Company</span>
      <h1>We build for the crews who keep the <span class="grad-text">physical economy running.</span></h1>
      <p class="lede">The people who build, clean, make, guard and move things are most of the world’s workforce. Most workforce software was never built for them. CrewTeams is.</p>
    </div>
  </section>

  <!-- WHY WE EXIST -->
  <section class="section">
    <div class="wrap why">
      <div class="why-stats">
        <div><span class="num">2.7B</span><span>frontline workers worldwide</span></div>
        <div><span class="num">80%</span><span>of the global workforce</span></div>
      </div>
      <div>
        <span class="eyebrow">Why we exist</span>
        <h2>Most of the world’s workforce has been left out of workforce software.</h2>
        <p>Office workers got cloud HR, self-service apps and AI assistants. Frontline crews got punch clocks, paper timesheets, group texts and a supervisor’s cell phone.</p>
        <p>The cost shows up every shift: people who don’t show, credentials that lapse, hours nobody can verify, and good workers who leave for the next offer. We started CrewTeams to fix that, with one platform built around the worker instead of the desk.</p>
        <ul class="inds" aria-label="Industries we serve">{industries.map((i) => <li>{i}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- WHAT WE BELIEVE -->
  <section class="section soft">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">What we believe</span>
        <h2>Four principles behind every decision.</h2>
      </div>
      <div class="beliefs">
        {beliefs.map((b) => <article class="belief"><h3>{b.t}</h3><p>{b.d}</p></article>)}
      </div>
    </div>
  </section>

  <!-- LEADERSHIP -->
  <section class="section">
    <div class="wrap lead-grid">
      <div>
        <span class="eyebrow">Leadership</span>
        <h2>Built by people who’ve run frontline workforces at scale.</h2>
        <p class="lede">CrewTeams is led by operators who have spent their careers staffing, verifying and paying frontline workers, not by people who discovered them last year.</p>
      </div>
      <article class="person">
        <div class="avatar" aria-hidden="true">DW</div>
        <div>
          <h3>Dan White</h3>
          <p class="role">Founder &amp; CEO</p>
          <p>Dan has spent more than two decades building workforce businesses. He led the growth of the strategic workforce solutions division at AMN Healthcare, served as Chief Commercial Officer at Cross Country Healthcare, and founded a frontline workforce management and verification platform before starting CrewTeams.</p>
        </div>
      </article>
    </div>
  </section>

  <!-- MORE / CONTACT -->
  <section class="section soft">
    <div class="wrap more">
      <a class="more-card" href="/company/partners/">
        <span class="eyebrow">Partners</span>
        <h3>The partners behind the platform</h3>
        <p>Payments, motivation science and market pay data from partners who specialize in them.</p>
        <span class="go">Meet our partners →</span>
      </a>
      <a class="more-card" href="/company/science/">
        <span class="eyebrow">The Science of Motivation</span>
        <h3>Why crews show up, and stay</h3>
        <p>The research behind how CrewTeams recognizes, rewards and keeps frontline workers.</p>
        <span class="go">Read the science →</span>
      </a>
      <div class="more-card contact">
        <span class="eyebrow">Get in touch</span>
        <h3>CrewTeams</h3>
        <p>{site.address}</p>
        <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
    </div>
  </section>

  <PageCTA title="See CrewTeams on one of your shifts." />
</Base>

<style>
  .co-hero { padding: 72px 0 56px; background: radial-gradient(1000px 420px at 90% -20%, rgba(26,138,80,.10), transparent 60%), radial-gradient(800px 420px at -10% 0%, rgba(30,99,165,.10), transparent 60%); }
  .co-hero h1 { max-width: 22ch; font-size: clamp(2.2rem, 4.6vw, 3.5rem); text-wrap: balance; }
  .co-hero .lede { margin-top: 18px; }

  .head { max-width: 760px; margin-bottom: 40px; }
  .head h2 { text-wrap: balance; }

  .why { display: grid; grid-template-columns: .8fr 1.2fr; gap: 64px; align-items: center; }
  .why h2 { text-wrap: balance; }
  .why p { color: var(--muted); max-width: 62ch; }
  .why-stats { display: grid; gap: 14px; }
  .why-stats > div { background: var(--ink); border-radius: 18px; padding: 28px; display: grid; gap: 6px; color: #AFC0D2; }
  .why-stats .num { font-size: 3.2rem; font-weight: 900; line-height: 1; color: #fff; }
  .inds { list-style: none; padding: 0; margin: 24px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .inds li { border: 1px solid var(--line); border-radius: 999px; padding: 6px 13px; font-weight: 700; font-size: .9rem; color: var(--ink); }

  .beliefs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
  .belief { background: #fff; border-radius: var(--radius); padding: 26px 22px; border-top: 4px solid var(--teal); box-shadow: 0 2px 10px rgba(11,31,51,.05); }
  .belief h3 { font-size: 1.1rem; }
  .belief p { margin: 0; color: var(--muted); font-size: .96rem; }

  .lead-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: 64px; align-items: center; }
  .lead-grid h2 { text-wrap: balance; }
  .person { display: grid; grid-template-columns: 96px 1fr; gap: 22px; border: 1px solid var(--line); border-radius: 20px; padding: 28px; }
  .avatar { width: 96px; height: 96px; border-radius: 50%; background: var(--brand-grad); color: #fff; display: grid; place-items: center; font-weight: 900; font-size: 1.6rem; }
  .person h3 { margin: 0; font-size: 1.3rem; }
  .role { color: var(--teal); font-weight: 700; margin: 2px 0 12px; }
  .person p:last-child { color: var(--muted); margin: 0; }


  .more { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .more-card { display: block; text-decoration: none; color: inherit; border: 1px solid var(--line); border-radius: 18px; padding: 26px 24px; background: #fff; transition: box-shadow .15s, transform .15s; }
  a.more-card:hover { box-shadow: var(--shadow); transform: translateY(-2px); }
  .more-card h3 { font-size: 1.15rem; }
  .more-card p { color: var(--muted); font-size: .95rem; margin: 0 0 12px; }
  .more-card.contact { background: var(--ink); border-color: var(--ink); }
  .more-card.contact h3 { color: #fff; }
  .more-card.contact p { color: #AFC0D2; }
  .more-card.contact a { color: #fff; }
  .more-card.contact .eyebrow { color: var(--gold); }
  .go { font-weight: 700; color: var(--blue); }

  @media (max-width: 960px) {
    .why, .lead-grid { grid-template-columns: 1fr; gap: 36px; }
    .beliefs { grid-template-columns: 1fr 1fr; }
    .more { grid-template-columns: 1fr; }
    .why-stats { grid-template-columns: 1fr 1fr; }
    .section { padding: 72px 0; }
  }
  @media (max-width: 560px) {
    .beliefs { grid-template-columns: 1fr; }
    .person { grid-template-columns: 1fr; }
    .why-stats .num { font-size: 2.4rem; }
    .co-hero { padding-top: 40px; }
    }
</style>
